# Machine-specific and generated files - never commit these.
# Note: gitignore has no inline comments, so every note needs its own line.

# Per-PC settings (speaker name). Copy from config.example.json.
config.json

# Per-PC interpreter path, written by install.ps1
pythonw.txt

# Outage history and announcement history are personal
*.log

# Runtime state
*.pid
*.lock

# Generated speech, rebuilt automatically on first run
voice_cache/

__pycache__/
*.pyc
